# Copy to .env only if you are not using the setup wizard.
# Configure at least one platform token. Never commit the real file.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
# DISCORD_BOT_TOKEN=replace_with_discord_bot_token

# SHA-256 of a private pairing code. The setup wizard generates this safely.
BOT_PAIR_CODE_SHA256=replace_with_64_character_sha256

# Folder whose immediate child folders are Git projects.
CODEX_PROJECT_ROOT=/path/to/projects
BOT_STATE_FILE=/path/to/private/state.json
CODEX_ARTIFACT_ROOT=/path/to/private/artifacts
CODEX_BINARY=codex
CODEX_TIMEOUT_SECONDS=3600
CODEX_MAX_CONCURRENT_SESSIONS=5
LOG_LEVEL=INFO

# Optional: pre-authorize Discord instead of pairing by DM.
# DISCORD_ALLOWED_USER_ID=123456789012345678
# Optional: allow that same user in one server channel as well as DMs.
# DISCORD_ALLOWED_CHANNEL_ID=123456789012345678
