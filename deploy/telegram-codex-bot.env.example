# Store the real file only at /etc/telegram-codex-bot.env with mode 0600.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_PAIR_CODE_SHA256=replace_with_sha256_hex
CODEX_PROJECT_ROOT=/home/user/Raspberry_Pi
# Comma-separated explicit exceptions for immediate non-Git project folders.
CODEX_EXTRA_PROJECTS=zeta-chat-ui
BOT_STATE_FILE=/var/lib/telegram-codex-bot/state.json
CODEX_BINARY=/usr/local/bin/codex
CODEX_TIMEOUT_SECONDS=3600
CODEX_MAX_CONCURRENT_SESSIONS=5
TELEGRAM_POLL_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# Optional Discord Gateway bridge. Keep the token only in /etc/telegram-codex-bot.env.
DISCORD_BOT_TOKEN=replace_me
DISCORD_ALLOWED_USER_ID=replace_with_numeric_user_id
# Omit for DM-only operation; set this to allow one server channel instead.
# DISCORD_ALLOWED_CHANNEL_ID=replace_with_numeric_channel_id
